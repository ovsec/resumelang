{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "resumelang",
  "description": "A universal resume DSL — one resume.yml, every output (HTML, PDF, JSON, Markdown, ATS text).",
  "colors": {
    "primary": "#7c8cff",
    "light": "#a6b1ff",
    "dark": "#5566e0"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Authoring",
            "pages": [
              "schema",
              "themes",
              "editor"
            ]
          },
          {
            "group": "Shipping",
            "pages": [
              "cli",
              "ci",
              "extension"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/schema-v1",
              "reference/cli"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/ovsec/resumelang",
          "icon": "github"
        },
        {
          "anchor": "Schema",
          "href": "https://resumelang.dev/schema/v1.json",
          "icon": "code"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/ovsec/resumelang"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Try the editor",
      "href": "https://resumelang.dev"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ovsec/resumelang"
    }
  }
}
