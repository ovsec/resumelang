{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://resumelang.dev/schema/v1.json",
  "title": "resumelang Resume",
  "description": "Schema for resumelang DSL v1. Add `resumelang: v1` and a `# yaml-language-server: $schema=...` comment to enable editor autocomplete.",
  "type": "object",
  "required": ["person"],
  "additionalProperties": false,
  "properties": {
    "resumelang": {
      "type": "string",
      "enum": ["v1"],
      "description": "DSL spec version. Always `v1` for this schema."
    },
    "meta": { "$ref": "#/definitions/Meta" },
    "person": { "$ref": "#/definitions/Person" },
    "summary": { "type": "string" },
    "experience": { "type": "array", "items": { "$ref": "#/definitions/Job" } },
    "education": { "type": "array", "items": { "$ref": "#/definitions/Education" } },
    "skills": { "type": "array", "items": { "$ref": "#/definitions/SkillGroup" } },
    "projects": { "type": "array", "items": { "$ref": "#/definitions/Project" } },
    "publications": { "type": "array", "items": { "$ref": "#/definitions/Publication" } },
    "certifications": { "type": "array", "items": { "$ref": "#/definitions/Certification" } },
    "languages": { "type": "array", "items": { "$ref": "#/definitions/Language" } },
    "volunteer": { "type": "array", "items": { "$ref": "#/definitions/Volunteer" } },
    "awards": { "type": "array", "items": { "$ref": "#/definitions/Award" } },
    "custom": { "type": "array", "items": { "$ref": "#/definitions/Section" } }
  },
  "definitions": {
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "string",
          "description": "Theme folder name under ./themes/, or any custom name. Built-ins: minimal, aurora, material, terminal, sap."
        },
        "language": { "type": "string", "examples": ["en", "de", "fr", "es"] },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
        "font": { "type": "string", "enum": ["inter", "mono", "serif"] },
        "page_size": { "type": "string", "enum": ["a4", "letter"] },
        "sections": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Order + visibility of sections. Names: summary, experience, education, skills, projects, publications, certifications, languages, volunteer, awards."
        },
        "tokens": {
          "type": "object",
          "description": "Override theme design tokens (colors, spacing, typography, radius, ...). Deep-merged onto the theme's own tokens at render time.",
          "additionalProperties": true
        }
      }
    },
    "Person": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "website": { "type": "string", "format": "uri" },
        "github": { "type": "string", "description": "GitHub username (no @ or URL)." },
        "linkedin": { "type": "string", "description": "LinkedIn vanity slug." },
        "avatar": { "type": "string", "format": "uri" }
      }
    },
    "Job": {
      "type": "object",
      "required": ["company", "role"],
      "additionalProperties": false,
      "properties": {
        "company": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "start": { "type": "string", "description": "Year or YYYY-MM." },
        "end": { "type": "string", "description": "Year, YYYY-MM, or empty string for Present." },
        "description": { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "Education": {
      "type": "object",
      "required": ["institution"],
      "additionalProperties": false,
      "properties": {
        "institution": { "type": "string", "minLength": 1 },
        "degree": { "type": "string" },
        "field": { "type": "string" },
        "location": { "type": "string" },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "gpa": { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "SkillGroup": {
      "type": "object",
      "required": ["category", "skills"],
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "skills": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "github": { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "Publication": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string" },
        "date": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "summary": { "type": "string" }
      }
    },
    "Certification": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string" },
        "date": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "id": { "type": "string", "description": "Certification ID / code (e.g. SAP C_TS4FI_2023)." }
      }
    },
    "Language": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "proficiency": {
          "type": "string",
          "examples": ["native", "fluent", "professional", "conversational", "basic", "C1", "C2", "B2"]
        }
      }
    },
    "Volunteer": {
      "type": "object",
      "required": ["organization"],
      "additionalProperties": false,
      "properties": {
        "organization": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "description": { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "Award": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "awarder": { "type": "string" },
        "date": { "type": "string" },
        "summary": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "Section": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "items": { "$ref": "#/definitions/SectionItem" } }
      }
    },
    "SectionItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
