<!DOCTYPE html>
<html lang="{{default meta.language "en"}}">
<head>
  <meta charset="UTF-8">
  <title>{{person.name}} — {{default person.title "CV"}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&family=Source+Serif+4:wght@600&display=swap" rel="stylesheet">
  <style>
    :root {
      --rl-bg: {{tokens.colors_background}};
      --rl-sidebar: {{tokens.colors_sidebar}};
      --rl-fg: {{tokens.colors_text_primary}};
      --rl-fg-dim: {{tokens.colors_text_secondary}};
      --rl-rule: {{tokens.colors_rule}};
      --rl-accent: {{tokens.colors_accent}};
      --rl-accent-alt: {{tokens.colors_accent_alt}};
      --rl-section-gap: {{tokens.spacing_section_gap}}px;
      --rl-item-gap: {{tokens.spacing_item_gap}}px;
      --rl-body-size: {{tokens.typography_body_size}}pt;
    }
    {{{themeCSS}}}
  </style>
</head>
<body>
  <div class="page">
    <header class="hero">
      <div class="hero-id">
        <h1>{{person.name}}</h1>
        {{#if person.title}}<p class="role">{{person.title}}</p>{{/if}}
      </div>
      <div class="hero-meta">
        {{#if person.email}}<span><b>E</b> {{person.email}}</span>{{/if}}
        {{#if person.phone}}<span><b>T</b> {{person.phone}}</span>{{/if}}
        {{#if person.location}}<span><b>L</b> {{person.location}}</span>{{/if}}
        {{#if person.linkedin}}<span><b>in</b> linkedin.com/in/{{person.linkedin}}</span>{{/if}}
      </div>
    </header>

    <div class="grid">
      <main class="main">
        {{#if summary}}
        <section>
          <h2>Profile</h2>
          <p>{{summary}}</p>
        </section>
        {{/if}}

        {{#if experience}}
        <section>
          <h2>Professional Experience</h2>
          {{#each experience}}
          <article class="job" id="{{_rl_id}}" data-rl-id="{{_rl_id}}">
            <div class="job-head">
              <div>
                <span class="job-role">{{role}}</span>
                <span class="job-company">— {{company}}</span>
              </div>
              <span class="job-dates">{{start}}{{#if end}} – {{end}}{{else}} – Present{{/if}}</span>
            </div>
            {{#if location}}<p class="job-loc">{{location}}</p>{{/if}}
            {{#if description}}<p class="job-desc">{{description}}</p>{{/if}}
            {{#if highlights}}
            <ul>{{#each highlights}}<li>{{this}}</li>{{/each}}</ul>
            {{/if}}
            {{#if tags}}<p class="tags">{{join tags " · "}}</p>{{/if}}
          </article>
          {{/each}}
        </section>
        {{/if}}

        {{#if projects}}
        <section>
          <h2>Selected Engagements</h2>
          {{#each projects}}
          <article class="job" id="{{_rl_id}}" data-rl-id="{{_rl_id}}">
            <div class="job-head">
              <span class="job-role">{{name}}</span>
              {{#if start}}<span class="job-dates">{{start}}{{#if end}} – {{end}}{{/if}}</span>{{/if}}
            </div>
            {{#if description}}<p class="job-desc">{{description}}</p>{{/if}}
            {{#if highlights}}<ul>{{#each highlights}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
          </article>
          {{/each}}
        </section>
        {{/if}}

        {{#if education}}
        <section>
          <h2>Education</h2>
          {{#each education}}
          <article class="edu" id="{{_rl_id}}" data-rl-id="{{_rl_id}}">
            <div class="job-head">
              <span class="job-role">{{institution}}</span>
              <span class="job-dates">{{start}}{{#if end}} – {{end}}{{/if}}</span>
            </div>
            <p class="job-desc">{{degree}}{{#if field}}, {{field}}{{/if}}{{#if gpa}} · GPA {{gpa}}{{/if}}</p>
            {{#if highlights}}<ul>{{#each highlights}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
          </article>
          {{/each}}
        </section>
        {{/if}}
      </main>

      <aside class="sidebar">
        {{#if skills}}
        <section>
          <h3>Core Competencies</h3>
          {{#each skills}}
          <div class="skill-grp" id="{{_rl_id}}" data-rl-id="{{_rl_id}}">
            <div class="skill-cat">{{category}}</div>
            <div class="skill-list">{{join skills " · "}}</div>
          </div>
          {{/each}}
        </section>
        {{/if}}

        {{#if certifications}}
        <section>
          <h3>Certifications</h3>
          <ul class="aside-list">
          {{#each certifications}}
            <li id="{{_rl_id}}" data-rl-id="{{_rl_id}}">
              <span class="aside-title">{{name}}</span>
              {{#if issuer}}<span class="aside-meta">{{issuer}}{{#if date}}, {{date}}{{/if}}</span>{{/if}}
              {{#if id}}<span class="mono">{{id}}</span>{{/if}}
            </li>
          {{/each}}
          </ul>
        </section>
        {{/if}}

        {{#if languages}}
        <section>
          <h3>Languages</h3>
          <ul class="aside-list">
          {{#each languages}}
            <li id="{{_rl_id}}" data-rl-id="{{_rl_id}}"><span class="aside-title">{{name}}</span>{{#if proficiency}}<span class="aside-meta">{{proficiency}}</span>{{/if}}</li>
          {{/each}}
          </ul>
        </section>
        {{/if}}

        {{#if awards}}
        <section>
          <h3>Awards</h3>
          <ul class="aside-list">
          {{#each awards}}
            <li id="{{_rl_id}}" data-rl-id="{{_rl_id}}"><span class="aside-title">{{title}}</span>{{#if awarder}}<span class="aside-meta">{{awarder}}{{#if date}}, {{date}}{{/if}}</span>{{/if}}</li>
          {{/each}}
          </ul>
        </section>
        {{/if}}
      </aside>
    </div>
  </div>
</body>
</html>
