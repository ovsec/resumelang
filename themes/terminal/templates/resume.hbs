<!DOCTYPE html>
<html lang="{{meta.language}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{person.name}}{{#if person.title}} — {{person.title}}{{/if}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --rl-background: {{tokens.colors_background}};
      --rl-surface: {{tokens.colors_surface}};
      --rl-surface-hover: {{tokens.colors_surface_hover}};
      --rl-border: {{tokens.colors_border}};
      --rl-text-primary: {{tokens.colors_text_primary}};
      --rl-text-secondary: {{tokens.colors_text_secondary}};
      --rl-accent: {{tokens.colors_accent}};
      --rl-accent-glow: {{tokens.colors_accent_glow}};
      --rl-success: {{tokens.colors_success}};
      --rl-warning: {{tokens.colors_warning}};
      --rl-error: {{tokens.colors_error}};
      --rl-spacing-section-gap: {{tokens.spacing_section_gap}}px;
      --rl-typography-heading-weight: {{tokens.typography_heading_weight}};
      --rl-typography-body-size: {{tokens.typography_body_size}}px;
      --rl-radius-base: {{tokens.radius_base}}px;
    }

    {{{themeCSS}}}
  </style>
</head>
<body>
  <main class="container">
    <header class="header">
      <h1 class="name">{{person.name}}</h1>
      {{#if person.title}}<p class="title">{{person.title}}</p>{{/if}}
      <div class="contact-row">
        {{#if person.email}}<a href="mailto:{{person.email}}">{{person.email}}</a>{{/if}}
        {{#if person.location}}<span>| {{person.location}}</span>{{/if}}
        {{#if person.website}}<a href="{{person.website}}" target="_blank">{{person.website}}</a>{{/if}}
        {{#if person.github}}<a href="https://github.com/{{person.github}}" target="_blank">github/{{person.github}}</a>{{/if}}
        {{#if person.linkedin}}<a href="https://linkedin.com/in/{{person.linkedin}}" target="_blank">linkedin/{{person.linkedin}}</a>{{/if}}
      </div>
    </header>

    {{#if summary}}
    <section class="summary">
      <p>{{summary}}</p>
    </section>
    {{/if}}

    {{#if experience}}
    <section class="section">
      <h2 class="section-title">Experience</h2>
      {{#each experience}}
      <div class="job">
        <div class="job-header">
          <div>
            <span class="job-role">{{role}}</span>
            <span class="job-company">@ {{company}}</span>
          </div>
          <span class="job-dates">{{start}} — {{#if end}}{{end}}{{else}}Present{{/if}}</span>
        </div>
        {{#if location}}<p class="job-location">{{location}}</p>{{/if}}
        {{#if description}}<p class="job-description">{{description}}</p>{{/if}}
        {{#if highlights}}
        <ul class="job-highlights">
          {{#each highlights}}<li>{{this}}</li>{{/each}}
        </ul>
        {{/if}}
        {{#if tags}}
        <div class="tags">
          {{#each tags}}<span class="tag">{{this}}</span>{{/each}}
        </div>
        {{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if projects}}
    <section class="section">
      <h2 class="section-title">Projects</h2>
      {{#each projects}}
      <div class="project-item">
        <div class="project-name">
          {{#if url}}<a href="{{url}}" target="_blank">{{name}}</a>{{else}}{{name}}{{/if}}
        </div>
        {{#if description}}<p class="project-desc">{{description}}</p>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if skills}}
    <section class="section">
      <h2 class="section-title">Skills</h2>
      {{#each skills}}
      <div class="skill-group">
        <div class="skill-category">{{category}}</div>
        <div class="skills-list">{{join skills ", "}}</div>
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if education}}
    <section class="section">
      <h2 class="section-title">Education</h2>
      {{#each education}}
      <div class="education-item">
        <div class="edu-header">
          <span class="edu-institution">{{institution}}</span>
          <span class="edu-dates">{{start}} — {{end}}</span>
        </div>
        <p class="edu-degree">{{degree}}{{#if field}} in {{field}}{{/if}}</p>
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if certifications}}
    <section class="section">
      <h2 class="section-title">Certifications</h2>
      {{#each certifications}}
      <div class="cert-item">
        <span class="cert-name">{{name}}</span>
        {{#if issuer}}<span class="cert-issuer"> — {{issuer}}</span>{{/if}}
        {{#if date}}<span class="cert-date">{{date}}</span>{{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}
  </main>
</body>
</html>
